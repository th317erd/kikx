{
  "name": "kikx",
  "version": "0.1.0",
  "description": "Frame-based, plugin-driven multi-agent harness with pluggable persistence",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:watch": "node scripts/dev-watch.mjs",
    "login-link": "node scripts/request-login-link.mjs",
    "magic-link": "node scripts/request-login-link.mjs",
    "start": "node src/server/index.mjs",
    "start:dev": "node scripts/start-dev.mjs",
    "start:aeordb": "mkdir -p .aeordb /tmp/codex/kikx && AEORDB_LOG=${AEORDB_LOG:-aeordb=debug,aeordb_cli=info} AEORDB_LOG_MAGIC_LINKS=${AEORDB_LOG_MAGIC_LINKS:-1} ${AEORDB_BIN:-/home/wyatt/.local/bin/aeordb} start -D ${AEORDB_DATABASE:-.aeordb/kikx.aeordb} --host ${AEORDB_HOST:-127.0.0.1} --port ${AEORDB_PORT:-6830} --auth ${AEORDB_AUTH:-self} 2>&1 | tee ${AEORDB_LOG_PATH:-/tmp/codex/kikx/aeordb.log}",
    "start:aeordb:dev": "set -a; . ./.env.dev; set +a; npm run start:aeordb",
    "start:kikx": "node src/server/index.mjs",
    "start:kikx:dev": "node scripts/start-kikx-dev.mjs",
    "test": "timeout 600 node scripts/run-test-lanes.mjs",
    "test:unit": "timeout 300 node scripts/run-test-lanes.mjs unit",
    "test:all": "node scripts/run-test-lanes.mjs --all",
    "test:lanes": "node scripts/run-test-lanes.mjs",
    "test:ui:playwright": "timeout 120 node scripts/with-aeordb-token.mjs node --test --test-timeout=60000 'spec/ui/playwright/*-playwright.mjs'",
    "test:ui:playwright:direct": "timeout 120 node --test --test-timeout=60000 'spec/ui/playwright/*-playwright.mjs'",
    "test:ui:stagehand": "timeout 120 node scripts/with-aeordb-token.mjs node --test --test-timeout=60000 'spec/ui/stagehand/*-stagehand.mjs'",
    "test:ui:puppeteer": "timeout 120 node scripts/with-aeordb-token.mjs node --test --test-timeout=60000 'spec/ui/puppeteer/*-puppeteer.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-or-later",
  "optionalDependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^3.5.0",
    "playwright": "^1.60.0",
    "puppeteer-core": "^24.43.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.4.3"
  }
}
