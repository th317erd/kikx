# Kikx local development environment.
#
# Config keys are property paths. A property path maps to an environment
# variable by replacing every non-alphanumeric character in each segment with
# "_", joining the segments with "_", and uppercasing the result:
#
#   /org/aeor/kikx/database/driver -> ORG_AEOR_KIKX_DATABASE_DRIVER
#
# JSON env documents use the same property paths and map identically; a
# document of the form
#   { "org": { "aeor": { "kikx": { "database": { "driver": "aeordb" } } } } }
# sets the same key, ORG_AEOR_KIKX_DATABASE_DRIVER.
KIKX_HOST=127.0.0.1
KIKX_PORT=3000

# --- Database driver selection -------------------------------------------
# Which database driver the server instantiates. Built-ins: aeordb (default),
# sqlite, postgresql. The canonical property path is
# /org/aeor/kikx/database/driver; /kikx/database/driver is a transition alias.
# The value may be a bare driver ID or a plugin property-path value such as
# /org/aeor/kikx/plugins/database/postgresql@0.4.5.
#   /org/aeor/kikx/database/driver -> ORG_AEOR_KIKX_DATABASE_DRIVER
#   /kikx/database/driver          -> KIKX_DATABASE_DRIVER
ORG_AEOR_KIKX_DATABASE_DRIVER=aeordb

# --- SQLite driver -------------------------------------------------------
# File path (or sqlite: URL) for the sqlite driver; defaults to :memory:.
#   /org/aeor/kikx/database/path -> ORG_AEOR_KIKX_DATABASE_PATH
#   /kikx/database/path          -> KIKX_DATABASE_PATH
# ORG_AEOR_KIKX_DATABASE_PATH=./.kikx/kikx.sqlite

# --- PostgreSQL driver ---------------------------------------------------
# Connection URL for the postgresql driver. `pg` is an optional dependency and
# is only imported when this driver is selected.
#   /org/aeor/kikx/database/url -> ORG_AEOR_KIKX_DATABASE_URL
#   /kikx/database/url          -> KIKX_DATABASE_URL
# ORG_AEOR_KIKX_DATABASE_URL=postgres://kikx-dev@127.0.0.1:5432/kikx-dev

# --- AeorDB (default driver) --------------------------------------------
# The aeordb driver keeps its own historical keys, unchanged.
AEORDB_URL=http://127.0.0.1:6830
AEORDB_TOKEN=

# --- Kikx-native auth (Phase B) -----------------------------------------
# The first administrator is created while the user store is empty. Without
# this value the server starts but logs a warning and no one can sign in.
#   /kikx/admin/email -> KIKX_ADMIN_EMAIL
# KIKX_ADMIN_EMAIL=admin@example.com
#   /kikx/admin/name  -> KIKX_ADMIN_NAME
# KIKX_ADMIN_NAME=Kikx Admin

# Public base URL used to build absolute magic-link URLs. When empty the link
# is root-relative. /kikx/auth/public/url -> KIKX_AUTH_PUBLIC_URL
# KIKX_AUTH_PUBLIC_URL=https://kikx.example.com

# Magic-link delivery. mode=log (default) prints links to the server log;
# mode=smtp uses nodemailer (an optional dependency) and requires the smtp URL.
#   /kikx/auth/mailer/mode     -> KIKX_AUTH_MAILER_MODE
#   /kikx/auth/mailer/smtp/url -> KIKX_AUTH_MAILER_SMTP_URL
#   /kikx/auth/mailer/from     -> KIKX_AUTH_MAILER_FROM
KIKX_AUTH_MAILER_MODE=log
# KIKX_AUTH_MAILER_SMTP_URL=smtp://user:pass@mail.example.com:587
KIKX_AUTH_MAILER_FROM=Kikx <no-reply@localhost>

# Token lifetimes in seconds (defaults: 3600 / 2592000 / 900).
#   /kikx/auth/session/access/ttl/seconds  -> KIKX_AUTH_SESSION_ACCESS_TTL_SECONDS
#   /kikx/auth/session/refresh/ttl/seconds -> KIKX_AUTH_SESSION_REFRESH_TTL_SECONDS
#   /kikx/auth/magic/link/ttl/seconds      -> KIKX_AUTH_MAGIC_LINK_TTL_SECONDS
KIKX_AUTH_SESSION_ACCESS_TTL_SECONDS=3600
KIKX_AUTH_SESSION_REFRESH_TTL_SECONDS=2592000
KIKX_AUTH_MAGIC_LINK_TTL_SECONDS=900

# --- Plugin platform (campaign S1-S6) --------------------------------------
# SIGNATURES ARE REQUIRED BY DEFAULT (fail-closed): loadPlugins verifies a
# .kikx-sig envelope BEFORE the import, so refused code never executes.
#   required — every real deployment (this default).
#   unsafe   — DEV ONLY: loud startup warning, inventory signatureMode, and a
#              persistent Settings -> Plugins banner. Never ship it.
#   /kikx/plugin/signature/mode -> KIKX_PLUGIN_SIGNATURE_MODE
KIKX_PLUGIN_SIGNATURE_MODE=required

# Raw Ed25519 trust anchors, comma-separated (the Kikx publisher key plus
# operator keys, overlapping for rotation; envelope keyID is reserved).
#   /kikx/plugin/signature/public/keys -> KIKX_PLUGIN_SIGNING_PUBLIC_KEYS
# KIKX_PLUGIN_SIGNING_PUBLIC_KEYS=<raw-key-1>,<raw-key-2>

# Explicit gate for endpoints that LOAD or DELETE code (install / uninstall /
# enable): an open install endpoint is remote code execution with a JSON body.
#   /kikx/plugin/install/enabled -> KIKX_PLUGIN_INSTALL_ENABLED
# KIKX_PLUGIN_INSTALL_ENABLED=true

# npm registry allowlist for Browse search, {npm} installs, and update checks
# (comma-separated base URLs; default public npm). Hosts are CONFIGURATION,
# never hardcoded in code.
#   /kikx/plugin/registry/urls -> KIKX_PLUGIN_REGISTRY_URLS
# KIKX_PLUGIN_REGISTRY_URLS=https://registry.npmjs.org

# Landing root for fetched tarballs (default <service root>/.kikx/plugins/npm,
# deliberately outside every auto-scanned plugin site).
#   /kikx/plugin/npm/dir -> KIKX_PLUGIN_NPM_DIR
# KIKX_PLUGIN_NPM_DIR=
